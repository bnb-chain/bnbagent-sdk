# examples/voter — copy to .env and fill in your values.

NETWORK=bsc-testnet
# Must serve eth_getLogs for blocks as old as the voting window (the default
# bsc-mainnet RPC does not); watch.py checks this at startup.
# RPC_URL=

# Whitelisted voter private key
VOTER_PRIVATE_KEY=0x...

# ERC-8183 contract overrides (bsc-testnet defaults apply)
# ERC8183_COMMERCE_ADDRESS=
# ERC8183_ROUTER_ADDRESS=
# ERC8183_POLICY_ADDRESS=

# IPFS gateway for downloading deliverable manifests
# STORAGE_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Seconds before a voting window closes from which a disputed job whose
# deliverable could not be looked up on-chain is put to a vote anyway
# (default 1800, at most half the window)
# VOTER_DECISION_MARGIN_SECONDS=1800
