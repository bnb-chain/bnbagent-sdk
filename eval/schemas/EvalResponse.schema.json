      "required": [
        "name",
        "metric_id",
        "count",
        "scored",
        "errors",
        "skipped"
      ],
      "title": "MetricAggregate",
      "type": "object"
    },
    "MetricProvenance": {
      "additionalProperties": false,
      "properties": {
        "judge": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
