          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "pending_human"
          ]
        }
      },
      "required": [
        "status"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "$id": "urn:bnbagent-eval:schema:v1:EvalResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "aggregate": {
      "$ref": "#/$defs/Aggregate"
    },
    "attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Attestation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cost": {
      "$ref": "#/$defs/Cost",
      "default": {
        "judge_calls": 0,
        "tokens": 0,
        "usd_estimate": 0.0
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "response_hash": {
      "type": "string"
    },
    "result_hash": {
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "type": "array"
    },
    "schema_version": {
      "default": "bnbagent-eval/v1",
      "type": "string"
    },
    "stage": {
      "enum": [
        "dev",
        "registration",
        "pre_submit",
        "review",
        "vote"
      ]
    },
    "subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobSubject"
        },
        {
          "$ref": "#/$defs/AgentSubject"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "suite_hash": {
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "stage",
    "suite_hash",
    "results",
    "aggregate",
    "verdict",
    "provenance",
    "result_hash",
    "response_hash"
  ],
  "title": "EvalResponse",
  "type": "object"
}
