        "pass_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "score",
        "pass_rate",
        "error_rate",
        "cases"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "AppMetrics": {
