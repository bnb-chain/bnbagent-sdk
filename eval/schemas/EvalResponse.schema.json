        "agent_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "chain_id": {
          "type": "integer"
        },
        "registry": {
          "type": "string"
        },
        "type": {
          "const": "agent",
          "default": "agent"
        }
      },
      "required": [
        "chain_id",
        "registry",
        "agent_id"
      ],
      "title": "AgentSubject",
      "type": "object"
    },
    "Aggregate": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "integer"
        },
        "error_rate": {
          "type": "number"
